# Local safety backups (never sync these to GitHub).
backup-before-*/

# Python caches and generated bytecode.
__pycache__/
*.py[cod]
*$py.class

# Logs, temporary files, editor leftovers, and runtime state.
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
.roulette-dashboard.pid
.roulette-dashboard.lock
.codex-current-backup.txt

# Common generated/runtime directories.
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
tmp/
temp/
logs/
.runtime/
